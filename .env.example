# Copy this file to .env.local and fill in your own Supabase project's values.
# Find these under Supabase Dashboard -> Project Settings -> API.
# Never commit .env.local or any file containing real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for Phase 7 (AI-generated customer messages). Get one from
# https://platform.openai.com/api-keys. Server-side only — never exposed to
# the browser. If this is left unset, the rest of the app still runs; only
# "Generate message" will show a friendly configuration message.
OPENAI_API_KEY=

# Required for Phase 8 (sending WhatsApp messages via the Meta WhatsApp
# Cloud API). Server-side only — never exposed to the browser. Without
# these, the rest of the app still runs; Settings will show "WhatsApp
# isn't connected yet" and no send is possible.
#
# How to get these (requires a Meta Business account):
#   1. Create/access a Meta App at https://developers.facebook.com/apps
#      and add the "WhatsApp" product.
#   2. Under WhatsApp > API Setup, generate a permanent System User access
#      token with whatsapp_business_messaging permission — that's
#      WHATSAPP_ACCESS_TOKEN. This is a single, shared token for the whole
#      app in this MVP (see the Phase 8 migration's comment on
#      whatsapp_connections for why per-business tokens aren't stored yet).
#   3. Each business then enters its own Phone Number ID (and optionally
#      WhatsApp Business Account ID) in Settings -> WhatsApp Business —
#      those are NOT set here as env vars for a specific business, only as
#      optional defaults to pre-fill that form during local development.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Set this to any secret string of your choosing, then enter the SAME
# value in Meta's App Dashboard under WhatsApp > Configuration > Webhook
# ("Verify token"). Meta uses it to confirm the webhook URL belongs to you
# during the one-time verification handshake.
WHATSAPP_VERIFY_TOKEN=

# REQUIRED in production: your Meta App's "App Secret" (App Dashboard ->
# Settings -> Basic). Incoming webhook requests are verified against Meta's
# X-Hub-Signature-256 header so a forged request (fake replies, fake STOP
# opt-outs, fake delivery statuses) is never accepted. When NODE_ENV is
# "production" and this is empty, the webhook REFUSES every request (503).
# In local development it may be left empty: requests are then accepted
# unverified, with a warning in the logs.
WHATSAPP_APP_SECRET=

# WhatsApp message templates are no longer configured here. Since
# Milestone 2 they live in the database (message_templates) — see
# Settings -> WhatsApp templates. WHATSAPP_TEMPLATE_NAME /
# WHATSAPP_TEMPLATE_LANGUAGE are ignored if still set.

# Required only for the WhatsApp status webhook (/api/webhooks/whatsapp),
# which has no signed-in user session and so needs the service-role key to
# read/write the messages table. Find it under Supabase Dashboard ->
# Project Settings -> API -> service_role secret. NEVER expose this to the
# browser and never commit it — it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Required for Phase 14 (automated WhatsApp follow-ups). Set this to any
# long, random secret string. It protects the scheduler endpoint
# (/api/automations/run) so only your own deployment's cron job can trigger
# automated sends — never a public visitor. If you deploy on Vercel, add
# the SAME value as an environment variable there and Vercel Cron will send
# it automatically as a Bearer token (see vercel.json's schedule). If you
# self-host, point any external cron (e.g. a system cron job, GitHub
# Actions on a schedule, cron-job.org) at this endpoint every 5-10 minutes
# with header: Authorization: Bearer <this value>. Without this set, the
# endpoint refuses every request and NO automated message is ever sent —
# by design (see the Phase 14 report's "fail closed" note), so automations
# stay in draft/paused until this is configured.
CRON_SECRET=

# Required for pricing & billing via Razorpay Subscriptions (needed only
# for the Starter and Growth paid plans — the Free plan never talks to
# Razorpay at all, so the app is fully usable with none of this set).
# Get these from https://dashboard.razorpay.com/app/keys (test mode keys are
# fine for development — switch to live keys only when you're ready to take
# real payments). Server-side only — never exposed to the browser. Without
# these, the rest of the app still runs: every new business simply starts
# on the permanent Free plan, and /billing shows "online payment isn't
# configured yet" instead of a working "Switch to Starter/Growth" button.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The SAME key id as above, but exposed to the browser (Razorpay Checkout
# runs client-side and needs it to open the payment form) — never the
# secret. Mirrors NEXT_PUBLIC_SUPABASE_ANON_KEY's naming convention.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Set this to any secret string, then enter the SAME value in the Razorpay
# Dashboard under Settings -> Webhooks when you add the webhook pointed at
# /api/webhooks/razorpay (enable every "subscription.*" event). Without
# this set, the webhook route refuses every request — by design, since a
# billing webhook must never be trusted unverified (unlike the WhatsApp
# webhook's optional app secret).
RAZORPAY_WEBHOOK_SECRET=

# One-time setup: create a Plan in Razorpay for EACH PAID plan only —
# Starter and Growth (see lib/billing/plans.ts) — via the Razorpay
# Dashboard (Payment Pages -> Plans -> New Plan) or the Create a Plan API,
# matching the price/name/monthly interval defined in code, then paste the
# resulting Plan IDs here. Free needs no Plan ID; it's never created in
# Razorpay. Without these two set, "Change plan" on /billing shows a
# friendly "this plan isn't available for checkout yet" instead of
# crashing.
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=
